<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".OpenSchoolApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_graphite"
        android:roundIcon="@mipmap/ic_graphite"
        android:label="OpenSchool"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:supportsRtl="true">
        <!-- The launcher entries are the aliases below (one enabled at a time, see AppIcon.kt); the activity itself has none. -->
        <activity android:name=".MainActivity" android:exported="true" />
        <activity-alias
            android:name=".IconGraphite"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_graphite"
            android:roundIcon="@mipmap/ic_graphite"
            android:label="OpenSchool">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconInk"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_ink"
